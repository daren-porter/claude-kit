#!/bin/sh
# pre-commit - validate the plugin payload, and run the test gate, when a commit
# touches either.
#
# When a commit touches plugins/claude-kit/, run `claude plugin validate` so a
# frontmatter or manifest mistake fails the commit instead of shipping silently.
# Skips with a stderr note when the `claude` CLI is absent rather than failing
# the commit (this repo has no CI, so a soft gate beats a check that cannot run
# anywhere).
#
# Then, when a commit touches code the suite covers, run the test gate. Chosen
# over a CI job because this repo has no CI and adding one is a larger decision,
# and over a documented runner because that is what already existed and it is
# only as good as someone remembering. Keyed on staged paths for the same reason
# the validation is: a docs-only commit pays nothing, which matters because most
# commits here are docs. The suite is a HARD gate, unlike validation: node is
# always present (it runs the hooks), so there is no absent-tool case to be soft
# about, and a red suite means a shipped guard is broken.
#
# Known limitation: the gate keys on STAGED paths but validates the WORKING
# TREE, so a partial stage can pass validation while committing an invalid
# payload (and the converse can false-block). Accepted for a soft local gate;
# validating a git checkout-index copy would close it if it ever bites.
#
# Wired via: git config core.hooksPath .githooks

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

# The test gate first, because the plugin-validate branch below exits early when
# no plugin path is staged, and the suite covers tools/ and test/ too.
#
# Scope note: the gate keys on STAGED paths but runs against the WORKING TREE,
# the same known limitation the validation below carries and accepted for the
# same reason. A partial stage can therefore pass on unstaged fixes.
GATE_RAN=0
if git diff --cached --name-only -- 'plugins/claude-kit/hooks/' 'plugins/claude-kit/agents/' 'tools/' 'test/' | grep -q .; then
    GATE_RAN=1
    # Quiet on success, loud on failure. The runner emits full TAP for every
    # passing subtest, which on its own first live fire buried the commit in
    # 107KB of "ok" lines; a gate nobody can read past is a gate people bypass.
    if ! gate_out=$(node --test test/*.test.js tools/*.test.js < /dev/null 2>&1); then
        printf '%s\n' "$gate_out" >&2
        echo "test gate failed; commit blocked (fix the suite or bypass with --no-verify)" >&2
        exit 1
    fi
fi

# The de-naming check on a PROSE-ONLY commit, which the code-keyed gate above
# skips. This matters because prose is where that invariant actually drifted:
# every one of the sixteen sites found on 2026-09-04 was in docs/, authored after
# the sweep, and a docs-only commit is precisely the shape that introduces them.
# One test file, about 95ms, so it is cheap enough to run on any prose commit
# rather than being keyed to a subset of them.
if [ "$GATE_RAN" -eq 0 ] \
   && git diff --cached --name-only | grep -v '^docs/archive/' | grep -q .; then
    if ! dn_out=$(node --test test/denaming.test.js < /dev/null 2>&1); then
        printf '%s\n' "$dn_out" >&2
        echo "de-naming check failed; commit blocked (fix the wording or bypass with --no-verify)" >&2
        exit 1
    fi
fi

# Only validate when plugin sources are part of this commit.
if ! git diff --cached --name-only -- 'plugins/claude-kit/' | grep -q .; then
    exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
    echo "claude CLI not found; skipping plugin validation" >&2
    exit 0
fi

# One validation error is tolerated, and only that one: the CLI reserves the
# plugin's own name (a third-party name cannot start with "claude-"), present
# on 2.1.293 and 2.1.295. Installs still succeed with it, and renaming strands every
# existing install, so the name is kept and the debt is in docs/backlog.md.
# The JSON report is read rather than the printed one so the match is on the
# error's path and message. Every `errors` array is walked (the manifest's and
# each content file's), and anything else in any of them still blocks, as does
# a report that fails to parse.
if ! report=$(claude plugin validate --json ./plugins/claude-kit 2>/dev/null); then
    if ! printf '%s' "$report" | node -e '
        let s = "";
        process.stdin.on("data", (c) => { s += c; }).on("end", () => {
            const errs = [];
            (function walk(v) {
                if (Array.isArray(v)) return v.forEach(walk);
                if (v && typeof v === "object") {
                    if (Array.isArray(v.errors)) errs.push(...v.errors);
                    Object.values(v).forEach(walk);
                }
            })(JSON.parse(s));
            const reserved = (e) => e.path === "name" && /^Plugin name "claude-kit" is reserved/.test(e.message);
            process.exit(errs.length > 0 && errs.every(reserved) ? 0 : 1);
        });' 2>/dev/null; then
        claude plugin validate ./plugins/claude-kit >&2
        echo "plugin validation failed; commit blocked (fix the payload or bypass with --no-verify)" >&2
        exit 1
    fi
    echo "plugin validation: passed except the known reserved-name error (docs/backlog.md)" >&2
fi

exit 0
